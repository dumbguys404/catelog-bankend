NODE_ENV=development

PORT=3000
HOST=0.0.0.0

DATABASE_URL=postgresql://username:password@localhost:5432/database_name

TENANT_BASE_DOMAIN=ourdomain.com
PLATFORM_HOST=platform.ourdomain.com

PLATFORM_ADMIN_USERNAME=platform-admin
PLATFORM_ADMIN_PASSWORD=replace-with-a-strong-platform-password

DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=15000
DB_QUERY_TIMEOUT_MS=20000

# Cloudflare R2 S3 API credentials. Restrict this token to the configured bucket.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=shop-product-images
R2_PUBLIC_URL=https://images.example.com
R2_UPLOAD_URL_TTL_SECONDS=300
R2_MAX_IMAGE_BYTES=15728640
